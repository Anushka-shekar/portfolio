{
  "name": "Portfolio Contact Inbox",
  "nodes": [
    {
      "id": "1",
      "name": "Contact Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "portfolio-contact-0001",
      "parameters": {
        "httpMethod": "POST",
        "path": "portfolio-contact",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "Check Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        240,
        200
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.headers['x-webhook-secret']}}",
              "value2": "CHANGE_ME_SECRET"
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Gemini Triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        120
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "PASTE_YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'Classify this portfolio contact message. Reply ONLY with JSON having keys: category (one of recruiter, collaboration, question, spam, other), summary (one sentence), reply (a short, polite draft reply written as Anushka Shekar, a 3rd year ISE student; do not invent facts or promises). Sender: ' + $json.body.name + '. Message: ' + $json.body.message }] }], generationConfig: { responseMimeType: 'application/json' } }) }}",
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Parse AI Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        120
      ],
      "parameters": {
        "jsCode": "const b = $('Contact Webhook').first().json.body;\nlet ai = { category: 'unclassified', summary: 'AI triage unavailable', reply: '' };\ntry {\n  const t = $json.candidates[0].content.parts[0].text;\n  ai = { ...ai, ...JSON.parse(t) };\n} catch (e) {}\nreturn [{ json: { name: b.name, email: b.email, message: b.message, ...ai } }];"
      }
    },
    {
      "id": "5",
      "name": "Email Me",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        120
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "YOUR_EMAIL@gmail.com",
        "subject": "=[Portfolio] {{$json.category}}: message from {{$json.name}}",
        "emailType": "text",
        "message": "=From: {{$json.name}} <{{$json.email}}>\nCategory: {{$json.category}}\nSummary: {{$json.summary}}\n\nMessage:\n{{$json.message}}\n\nSuggested reply (edit before sending):\n{{$json.reply}}",
        "options": {
          "replyTo": "={{$json.email}}",
          "appendAttribution": false
        }
      }
    },
    {
      "id": "6",
      "name": "Auto-reply to Visitor",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1200,
        120
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{$('Parse AI Result').item.json.email}}",
        "subject": "Thanks for reaching out",
        "emailType": "text",
        "message": "=Hi {{$('Parse AI Result').item.json.name}},\n\nThanks for your message. I have received it and will get back to you soon.\n\nBest,\nAnushka Shekar",
        "options": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Contact Webhook": {
      "main": [
        [
          {
            "node": "Check Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Secret": {
      "main": [
        [
          {
            "node": "Gemini Triage",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Gemini Triage": {
      "main": [
        [
          {
            "node": "Parse AI Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse AI Result": {
      "main": [
        [
          {
            "node": "Email Me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Me": {
      "main": [
        [
          {
            "node": "Auto-reply to Visitor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}